DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=4000

# Comma-separated exact IPs allowed to call the unauthenticated /public/* routes
# (GET /public/tours, POST /public/bookings). No CIDR support. Empty/unset fails
# closed — the public API is unreachable until this is set. Only correct as long
# as this backend is directly exposed with no reverse proxy in front (a proxy
# would need `trust proxy` handling too, which this app does not have).
PUBLIC_API_IP_ALLOWLIST=""
