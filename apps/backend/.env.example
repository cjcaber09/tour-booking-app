# If this app shares a Supabase project with other, unrelated data, append
# &schema=<name> (DATABASE_URL) / ?schema=<name> (DIRECT_URL) to keep this app's
# tables isolated in their own Postgres schema instead of landing in "public".
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=4000

# Comma-separated exact IPs allowed to call the unauthenticated /public/* routes
# (GET /public/tours, POST /public/bookings). No CIDR support. Empty/unset fails
# closed — the public API is unreachable until this is set. Only correct as long
# as this backend is directly exposed with no reverse proxy in front (a proxy
# would need `trust proxy` handling too, which this app does not have).
PUBLIC_API_IP_ALLOWLIST=""

# Enables the in-memory dev audit log (captures method/path/status/duration/adminId for
# every request) and the GET /audit endpoint that serves it. Unset or anything other than
# "true" fails closed - both capture and the endpoint are off by default.
ENABLE_DEV_AUDIT_LOG="false"
