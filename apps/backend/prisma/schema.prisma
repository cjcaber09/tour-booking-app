generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
